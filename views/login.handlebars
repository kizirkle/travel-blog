<section class="info homediv padding">
    <h2>
        Login
    </h2>
    <h3 id="error-login"></h3>
<form class="form login-form form-group flex">
      <div class="form-part">
        <label for="username-login">Name:</label>
        <input class="form-input" type="text" id="username-login" />
      </div>
      <div class="form-part">
        <label for="password-login">Password:</label>
        <input class="form-input" type="password" id="password-login" />
      </div>
      <button type="submit" class="btn btn-primary">Log In</button>
    </form>
    
    <a  class="loginlink" href="/signup">Don't have an account? <span class="login-signup-color">Sign up!</span></a>
   
</section>
<script src="/js/login.js"></script>